# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Local (Docker)
POSTGRES_USER=sic
POSTGRES_PASSWORD=sic123
POSTGRES_DB=sales_intelligence
DATABASE_URL=postgresql://sic:sic123@db:5432/sales_intelligence

# Produção (Railway) — substitua pela URL fornecida pelo Railway
# DATABASE_URL=postgresql://user:pass@host.railway.internal:5432/railway

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# OBRIGATÓRIO: troque por um valor aleatório longo e seguro
JWT_SECRET=troque_este_segredo_por_um_valor_seguro_de_32_chars_minimo

# URL do frontend (para CORS em produção)
# FRONTEND_URL=https://seu-app.vercel.app

# ─── IA (escolha um modo) ─────────────────────────────────────────────────────
# Modo 1: OpenAI
OPENAI_API_KEY=

# Modo 2: Ollama local (gratuito)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Local
NEXT_PUBLIC_API_URL=http://localhost:3001

# Produção (Vercel) — configure como variável de ambiente no painel Vercel
# NEXT_PUBLIC_API_URL=https://seu-backend.railway.app

